# Database
# DB Provider: local | supabase
DB_PROVIDER=local

# Local PostgreSQL
DATABASE_LOCAL_URL="postgresql://postgres:postgres@localhost:5432/gap"

# Supabase PostgreSQL (required when DB_PROVIDER=supabase)
DATABASE_SUPABASE_URL="postgresql://postgres.project-ref:password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# JWT
JWT_ACCESS_SECRET="your_access_secret"
JWT_REFRESH_SECRET="your_refresh_secret"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY="your_openai_api_key"
# Optional additional keys used by batch scripts
OPENAI_API_KEY2="your_second_openai_api_key"
OPENAI_API_KEY3="your_third_openai_api_key"
OPENAI_ADMIN_KEY="your_openai_admin_key"

# LLM models
OPENAI_MODEL="gpt-4o-mini"
OPENAI_AI_ANALYSIS_MODEL="gpt-4o-mini"
OPENAI_AI_CANDIDATE_MODEL="gpt-4o"
OPENAI_AI_REPAIR_MODEL="gpt-4o"
OPENAI_AI_VERIFICATION_MODEL="gpt-4o"
OPENAI_STEP1_MODEL="gpt-4o-mini"
OPENAI_STEP2_MODEL="gpt-4o-mini"
OPENAI_SOLUTION_VALIDATION_MODEL="gpt-4o-mini"

# App
PORT=3001
NODE_ENV="development"

# Web Push (VAPID)
VAPID_PUBLIC_KEY="your_vapid_public_key"
VAPID_PRIVATE_KEY="your_vapid_private_key"
VAPID_SUBJECT="mailto:your_email@example.com"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Frontend and CORS
FRONTEND_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173,http://localhost:3002"

# SMTP (Email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"
SMTP_FROM="GAP <your_email@gmail.com>"
# Optional: defaults to SMTP_USER when omitted.
REPORT_RECIPIENT_EMAIL="reports@example.com"

# Supabase API and Storage (required when DB_PROVIDER=supabase)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_key"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_POOLER_URL="postgresql://postgres.project-ref:password@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres"
GEMINI_API_KEY="your_gemini_api_key"

# --- AI 문항 생성 모델 (gemini-* 이면 GEMINI_API_KEY로 Gemini 엔드포인트, 그 외는 OpenAI 공식 API) ---
# 우선순위: AI_<ROLE>_MODEL > AI_GENERATION_MODEL > OPENAI_AI_<ROLE>_MODEL
# 출제: gpt-5.4 (추론형). Gemini가 안정되면 AI_GENERATION_MODEL="gemini-3.8-flash"로 바꿔 비교 가능
AI_GENERATION_MODEL="gpt-5.4"
# 검토(블라인드 풀이): 출제와 다른 모델로 교차 검증
AI_VERIFICATION_MODEL="gpt-5.4-mini"
# 추론 강도(low/medium/high). 이름은 GEMINI_지만 OpenAI 추론 모델에도 적용됨
GEMINI_REASONING_EFFORT="medium"
# 완전 AI 출제 추론 강도는 배점별 자동(출제 2점 low·3점 medium, 검토 2점 medium·3점 high). 고정하려면 아래 주석 해제
# AI_GENERATION_REASONING_EFFORT=low
# AI_VERIFICATION_REASONING_EFFORT=medium
# 참조 문항 없는 완전 AI 출제 (sourceType=ai_generative)
ENABLE_AI_GENERATIVE_GENERATION=false
AI_GENERATIVE_CONCURRENCY=4
AI_GENERATIVE_MAX_ATTEMPTS=3
# true면 본 문항이 처음 반려될 때 예비 문항을 병렬로 시작(빠르지만 비용 증가)
AI_GENERATIVE_HEDGE_RESERVES=false
# 추론 모델은 느리므로 호출당 4분, 시험 전체 25분
AI_GENERATIVE_PROVIDER_TIMEOUT_MS=240000
AI_GENERATIVE_JOB_TIMEOUT_MS=1500000
