    "backfill:reference-answer-keys": "node -r ts-node/register scripts/backfill-reference-answer-keys.ts",
    "sync:reference-answer-keys": "node -r ts-node/register scripts/sync-reference-answer-keys.ts",
    "repair:reference-context": "node -r ts-node/register scripts/repair-reference-context.ts",
    "fix:reference-unit-concepts": "node -r ts-node/register scripts/fix-reference-unit-concepts.ts",
    "preflight:reference-catalog": "node -r ts-node/register scripts/reference-catalog-preflight.ts",
    "preflight:reference-catalog:markdown": "node -r ts-node/register scripts/reference-catalog-preflight.ts --format=markdown",
    "rebuild:ai-unit-profiles": "node -r ts-node/register scripts/rebuild-ai-unit-profiles.ts",
    "audit:concept-reference-consistency": "node -r ts-node/register scripts/audit-concept-reference-consistency.ts",
    "backfill:study-must-know": "node -r ts-node/register scripts/backfill-study-must-know.ts",
    "enrich:study-must-know-ai": "node -r ts-node/register scripts/enrich-study-must-know-ai.ts",
    "generate:study-representative-cards": "node -r ts-node/register scripts/generate-representative-study-cards.ts",
    "rebuild:concept-tags:offline": "node -r ts-node/register scripts/rebuild-existing-concept-tags-offline.ts",
    "shadow:ai": "node -r ts-node/register scripts/ai-shadow-evaluation.ts",
    "export:ai-baseline": "node -r ts-node/register scripts/export-ai-baseline-corpus.ts",
    "inventory:ai-catalog": "node -r ts-node/register scripts/inventory-ai-catalog.ts",
    "plan:reference-catalog-legacy-migration": "node -r ts-node/register scripts/plan-reference-catalog-legacy-migration.ts",
    "seed:textbook:local": "node -r ts-node/register scripts/seed-local-textbook.ts",
