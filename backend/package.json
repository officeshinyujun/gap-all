    "import:reference-catalog": "node -r ts-node/register src/textbook/import-reference-catalog.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit --project tsconfig.eslint.json",
    "lint": "npm run typecheck && eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:reference-live": "node -r ts-node/register scripts/reference-live-qa.ts",
    "inventory:reference-sources": "node -r ts-node/register scripts/inventory-reference-sources.ts",
    "extract:reference-evidence": "node -r ts-node/register scripts/extract-reference-evidence.ts",
    "extract:reference-questions": "node -r ts-node/register scripts/extract-reference-questions-v2.ts",
