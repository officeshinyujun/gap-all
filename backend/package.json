{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "summarize:textbook": "node -r ts-node/register src/textbook/generate-summations.ts",
    "summarize:textbook:structured-unit": "node -r ts-node/register src/textbook/generate-structured-unit.ts",
    "summarize:textbook:structured-unit:merged": "node -r ts-node/register src/textbook/generate-structured-unit-merged.ts",
